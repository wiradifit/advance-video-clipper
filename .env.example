# ==============================================================================
# Advance AI Video Clipper - Environment Configuration
# ==============================================================================

# LLM API Provider (OpenAI compatible endpoint)
# Examples:
# OpenAI: https://api.openai.com/v1 (Model: gpt-4o-mini or gpt-4o)
# DeepSeek: https://api.deepseek.com/v1 (Model: deepseek-chat)
# Groq: https://api.groq.com/openai/v1 (Model: llama-3.3-70b-versatile)
# OpenRouter: https://openrouter.ai/api/v1
# Local Ollama: http://localhost:11434/v1

LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY="your-api-key-here"
LLM_MODEL="gpt-4o-mini"

# Whisper Speech Recognition Model (tiny, base, small, medium, large-v3)
# 'base' is recommended for high speed with excellent accuracy
WHISPER_MODEL="base"

# Output Directory (Relative or Absolute path)
OUTPUT_DIR="./output_clips"
